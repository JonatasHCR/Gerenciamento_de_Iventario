# Template das variáveis lidas pelo docker-compose.yml.
# Copie este arquivo para `.env` na raiz do projeto e ajuste:
#   cp .env.example .env
#
# O .env real NÃO deve ser commitado (já está no .gitignore).

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=trocar_esta_senha
POSTGRES_DB=invcontrol

# Backend
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=trocar_por_uma_chave_aleatoria_de_64_chars_via_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Debug do SQLAlchemy. true = loga toda query (perf hit). NUNCA true em prod.
DEBUG=false

# Origens permitidas no CORS, separadas por vírgula.
# Em prod: troque pelo domínio real (ex.: https://invcontrol.empresa.com)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limit do /auth/login (slowapi: "N/segundo|minuto|hora")
LOGIN_RATE_LIMIT=10/minute

# Domínios permitidos no auto-registro público (POST /users/).
# Separe com vírgula. Vazio = aceita qualquer domínio.
# Ex.: ALLOWED_EMAIL_DOMAINS=empresa.com,parceiro.com
ALLOWED_EMAIL_DOMAINS=

# Portas expostas no host (mude se houver conflito local)
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
