# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=trocar_esta_senha
POSTGRES_DB=invcontrol

# Backend
# Gere uma chave forte com: python -c "import secrets; print(secrets.token_hex(32))"

# Debug do SQLAlchemy. true = loga toda query (perf hit). NUNCA true em prod.
DEBUG=false

# Origens permitidas no CORS, separadas por vírgula.
# Em prod: troque pelo domínio real (ex.: https://invcontrol.empresa.com)
ALLOWED_ORIGINS=http://localhost:3000

# Portas expostas no host (mude se houver conflito local)
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Backup (docker compose --profile backup up -d) -------------------
# Quantos dias manter os backups antes de rotacionar
BACKUP_KEEP_DAYS=7
# Intervalo entre backups automáticos (em horas)
BACKUP_INTERVAL_HOURS=24

# --- Gitea Runner (docker compose --profile gitea up -d) --------------
# URL do Gitea já existente (ex: http://192.168.1.10:3000)
GITEA_INSTANCE_URL=http://localhost:3000
# Token de registro: Gitea → Admin → Actions → Runners → Criar runner
GITEA_RUNNER_TOKEN=trocar_pelo_token_gerado_no_gitea
# Nome exibido na lista de runners do Gitea (opcional)
GITEA_RUNNER_NAME=local-runner

# HOST_IP e mantido em dia por infra/scripts/sync_host_ip.py; edite no infra/.env.
HOST_IP=

# Conta mestra: UM email, o mesmo nos tres sistemas, que entra como
# administrador aqui sem depender de grupo nem de script de promocao.
# Preenchido por `python infra/scripts/sync_host_ip.py` — nao edite a mao.
ADMIN_MESTRE_EMAIL=
INVENTARIO_CLIENT_SECRET=
# Cifra o cookie de sessao (JWE). Minimo 32 chars: openssl rand -hex 32
INVENTARIO_SESSION_SECRET=

# --- Sincronizacao com a receita (Fase 6) ---
# O token e o MESMO SYNC_API_TOKEN do .env da receita.
RECEITA_PORT=3040
RECEITA_API_TOKEN=
SYNC_INTERVAL_MINUTES=15
