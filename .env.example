# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=trocar_esta_senha
POSTGRES_DB=invcontrol

# Debug do SQLAlchemy: true loga toda query. NUNCA true em producao.
DEBUG=false

# Origens permitidas no CORS, separadas por vírgula.
ALLOWED_ORIGINS=http://localhost:3000

# Portas expostas no host
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Backup (docker compose --profile backup up -d) ---
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_HOURS=24

# HOST_IP e mantido em dia por infra/scripts/sync_host_ip.py; edite no infra/.env.
HOST_IP=

# Conta mestra: UM email, o mesmo nos tres sistemas, que entra como
# administrador aqui sem depender de grupo nem de script de promocao.
# Preenchido por `python infra/scripts/sync_host_ip.py` — nao edite a mao.
ADMIN_MESTRE_EMAIL=
INVENTARIO_CLIENT_SECRET=
# Cifra o cookie de sessao (JWE). Minimo 32 chars: openssl rand -hex 32
INVENTARIO_SESSION_SECRET=

# --- Sincronizacao com a receita ---
# O token e o MESMO SYNC_API_TOKEN do .env da receita.
RECEITA_PORT=3040
RECEITA_API_TOKEN=
SYNC_INTERVAL_MINUTES=15
